{
  "name": "ai-sdk-nodejs-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build server.mjs -o dist",
    "build:esbuild": "node esbuild.config.js",
    "build:rollup": "rollup -c rollup.config.js",
    "dev": "node server.js",
    "profile-startup": "node --cpu-prof --cpu-prof-name=startup.cpuprofile server.js",
    "check-startup": "node check-startup.js ./dist/index.mjs",
    "check-startup:esbuild": "node check-startup.js ./dist-esbuild/index.js",
    "check-startup:rollup": "node check-startup.js ./dist-rollup/index.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.8",
    "@vercel/ncc": "^0.38.4",
    "ai": "^3.4.33",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "rollup": "^4.30.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0"
  }
}
